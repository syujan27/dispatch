rules_version = '2';
// 每日派車管理系統：資料庫權限規則
// 1. 把 ownerList() 裡的信箱換成你自己的 Gmail（全部小寫）。
//    名單裡的人是「最高管理員」，一定能登入、擁有全部權限。
// 2. 其他同事不用寫在這裡，請在系統的「權限管理」頁新增。
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerList() {
      return [
        "你的帳號@gmail.com",
      ];
    }

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() in ownerList(); }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function me() { return get(memberPath()).data; }
    function isMember() { return isOwner() || (signedIn() && exists(memberPath()) && me().active == true); }
    function myRole() { return get(/databases/$(database)/documents/roles/$(me().roleId)).data; }
    function isAdmin() { return isOwner() || (isMember() && me().roleId == 'admin'); }
    function canManage() { return isAdmin() || (isMember() && myRole().canManage == true); }
    function has(m) { return isAdmin() || (isMember() && m in myRole().modules); }

    match /vehicles/{id}  { allow read: if isMember(); allow write: if has('vehicles'); }
    match /customers/{id} { allow read: if isMember(); allow write: if has('customers'); }
    match /trips/{id}     { allow read: if isMember(); allow write: if has('dash') || has('trips'); }
    match /tripTypes/{id} { allow read: if isMember(); allow write: if has('tripTypes') || canManage(); }
    match /roles/{id}     { allow read: if isMember(); allow write: if canManage(); }
    match /groups/{id}    { allow read: if isMember(); allow write: if canManage(); }
    match /members/{email} {
      allow read: if signedIn() && (email == myEmail() || canManage());
      allow write: if canManage();
    }
  }
}
